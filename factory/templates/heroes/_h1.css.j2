{#- Headline rule for the 2B heroes. Include with `sel` (selector) and optional `vw`, `maxpx`, `caps_vw`:
    - display_case caps (or a caps-only pairing with no secondary): tracked caps 22-40 px (spec 3.4, E5 <= 60 chars).
    - otherwise sentence case in the display face, or the pairing's secondary face when the primary is caps-/wordmark-only;
      never below pair.display.min_px (contract 3.2); thin 400-weight faces with min_px >= 36 get a 48 px floor on mobile
      so the 1x hairline probe passes. -#}
{% set sec = pair.secondary if ((pair.display.caps_only or pair.display.wordmark_only) and pair.secondary) else None %}
{% set caps = (dialect and t.display_case == 'caps') or (pair.display.caps_only and not sec) %}
{% if caps %}
  {{ sel }} { font-family: var(--display); font-weight: var(--display-weight); text-transform: uppercase; letter-spacing: 0.12em; line-height: 1.2; --h1-size: clamp({{ [pair.display.min_px, 26]|max }}px, {{ caps_vw|default(2.6) }}vw, {{ [pair.display.max_px|default(40), 40]|min }}px); font-size: clamp({{ [pair.display.min_px, 26]|max }}px, {{ caps_vw|default(2.6) }}vw, {{ [pair.display.max_px|default(40), 40]|min }}px); text-wrap: balance; }
  {{ sel }} em { font-style: normal; font-weight: var(--display-weight); }
{% else %}
  {% set fam = ("'" ~ sec.family ~ "', " ~ sec.fallback) if sec else 'var(--display)' %}
  {% set w = sec.weight if sec else pair.display.weight %}
  {% set mn = [(sec.min_px if sec else pair.display.min_px), 40]|max %}
  {% set thin = (w <= 400) and (mn >= 36) %}
  {# 2C: a thin primary face never renders below its measured hairline floor on desktop (base.css.j2 --h1-floor uses the
     same numbers); the silent hero's 40 px cap set Marcellus at 40 px = 26% hairline at 1x #}
  {% set dfloor = (pair.display.hairline_floor_px|default(56 if pair.display.family in ('Forum', 'Libre Caslon Display', 'Italiana', 'Instrument Serif') else 48)) if (thin and not sec) else mn %}
  {# 2D: a measured floor in pairings.json (the face that sets this h1) always wins; mobile likewise #}
  {% set hface = sec if sec else pair.display %}
  {% if hface.hairline_floor_px is defined %}{% set dfloor = hface.hairline_floor_px %}{% endif %}
  {% set mfloor = hface.mobile_floor_px|default(48 if thin else mn) %}
  {% set mn_d = [mn, dfloor]|max %}
  {{ sel }} { font-family: {{ fam|safe }}; font-weight: {{ w }}; letter-spacing: {{ sec.tracking if sec else 'var(--display-track)' }}; line-height: {{ sec.line_height if sec else 'var(--display-lh)' }}; text-transform: none; font-size: clamp({{ mn_d }}px, {{ vw|default(5.4) }}vw, {{ [maxpx|default(80), mn_d]|max }}px); {% if sec %}font-variation-settings: normal; font-optical-sizing: auto;{% endif %} }
  {% if sec %}{{ sel }} em { font-weight: {{ sec.italic_weight }}; }{% endif %}
  @media (max-width: 600px) {
    {{ sel }} { --h1-size: clamp({{ mfloor }}px, 10.5vw, {{ [60, mfloor]|max }}px); font-size: var(--h1-size); }
  }
{% endif %}

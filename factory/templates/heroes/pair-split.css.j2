  /* hero: pair-split (deco): ivory band, rule, the pair */
{% include 'heroes/_shared.css.j2' %}
  .hero-pair-split { padding: clamp(32px, 4.5vw, 64px) 0 0; }
  .pair-head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr); gap: clamp(28px, 5vw, 88px); align-items: end; padding-bottom: clamp(24px, 3vw, 40px); }
  .pair-kicker { letter-spacing: 0.22em; }
{% with sel='.hero-pair-split h1', vw=5.6, maxpx=88, caps_vw=3.0 %}{% include 'heroes/_h1.css.j2' %}{% endwith %}
  .hero-pair-split h1 { max-width: 14ch; }
  .pair-lede { font-size: clamp(17px, 1.3vw, 19px); color: var(--ink-soft); max-width: 40ch; margin-bottom: 18px; }
  .pair-aside .hero-facts { padding-top: 16px; border-top: 1px solid var(--ink); }
  .pair-dates { display: grid; grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.9fr); gap: clamp(20px, 3vw, 48px); align-items: center; padding: clamp(18px, 2vw, 26px) 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .pair-dates-title { font-size: 13px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: {{ pair.body.medium }}; color: var(--ink); }
  .pair-dates .date-inline { margin: 0; }
  .pair-photos { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 2.5vw, 32px); padding: clamp(28px, 3.5vw, 48px) 0 clamp(8px, 1vw, 16px); }
  .pair-fig { margin: 0; }
  .pair-ph { aspect-ratio: 4 / 5; border-radius: 0; }
  .pair-ph img { aspect-ratio: 4 / 5; }
  .pair-mono .pair-ph img { filter: grayscale(1) contrast(1.05); }
  .pair-fig figcaption { display: flex; gap: 14px; align-items: baseline; margin-top: 12px; font-size: 13px; letter-spacing: 0.08em; color: var(--ink-soft); }
  .pair-num { font-family: var(--display); font-weight: var(--display-weight); font-size: 15px; letter-spacing: 0.12em; color: var(--accent-text); flex: 0 0 auto; }
  @media (max-width: 860px) {
    .pair-head { grid-template-columns: 1fr; gap: 22px; align-items: start; }
    .pair-dates { grid-template-columns: 1fr; gap: 12px; }
  }
  @media (max-width: 600px) {
    .pair-photos { grid-template-columns: 1fr; }
    .pair-ph, .pair-ph img { aspect-ratio: 4 / 5; }
  }

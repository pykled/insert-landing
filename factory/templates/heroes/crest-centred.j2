{# crest-centred (estate): full-bleed photo; crest (the site's ornament, hero slot) + tracked-caps name + one italic
   subline centred; two square outlined buttons. No form on the photo: the date band sits directly under it (4.3). #}
<section class="hero hero-crest{{ ' crest-on-paper' if hero_copy_on == 'paper' }}" data-hero="crest-centred" data-copy-on="{{ hero_copy_on|default('photo') }}" data-hero-framing="{{ dialect.hero_framing if dialect else 'crest' }}" aria-labelledby="hero-title">
  <div class="crest-stage">
    <div class="crest-media">
      <img src="{{ photos[lead].src }}" srcset="{{ photos[lead].srcset }}" sizes="(max-width: 860px) 180vw, 100vw" width="{{ photos[lead].width }}" height="{{ photos[lead].height }}" alt="{{ photos[lead].alt }}" style="object-position: {{ photos[lead].focal }}" fetchpriority="high" decoding="async">
    </div>
    <div class="container crest-copy">
      <div class="crest-mark hero-anim">{% include 'heroes/_ornament-slot.j2' %}</div>
      <p class="crest-name hero-anim">{{ v.short_name }}</p>
      <h1 id="hero-title" class="crest-sub hero-anim">{{ copy.hero_headline }}</h1>
      <p class="crest-loc hero-anim">{{ copy.hero_kicker }}</p>
      {% if hero_copy_on == 'paper' %}<div class="crest-facts hero-anim">{% include 'heroes/_facts.j2' %}</div>{% endif %}
      <div class="crest-actions hero-anim">
        <a class="btn crest-btn" href="#tour">{{ copy.tour_cta }}</a>
        <a class="btn crest-btn" href="#guide">{{ copy.guide_cta }}</a>
      </div>
    </div>
  </div>
  <div class="hero-dateband">
    <div class="container">
      <div>
        <p class="crest-lede">{{ copy.hero_lede }}</p>
        {% if hero_copy_on != 'paper' %}{% include 'heroes/_facts.j2' %}{% endif %}
      </div>
      {% include 'partials/date-inline.j2' %}
    </div>
  </div>
</section>

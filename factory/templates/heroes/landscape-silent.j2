{# landscape-silent (modern-luxe, ranch): a full-height photo of the land with nothing on it; a hairline facts strip
   directly under it keeps two facts inside the first screen (E19); the headline arrives below; date band (4.3).
   Needs lead >= 2400 px, subject place/grounds/building. #}
<section class="hero hero-landscape-silent" data-hero="landscape-silent" data-hero-framing="{{ dialect.hero_framing if dialect else 'silent' }}" aria-labelledby="hero-title">
  <figure class="lsil-media">
    <img src="{{ photos[lead].src }}" srcset="{{ photos[lead].srcset }}" sizes="(max-width: 860px) 160vw, 100vw" width="{{ photos[lead].width }}" height="{{ photos[lead].height }}" alt="{{ photos[lead].alt }}" style="object-position: {{ photos[lead].focal }}" fetchpriority="high" decoding="async">
  </figure>
  <div class="lsil-strip">
    <div class="container lsil-strip-inner">
      <p class="lsil-kicker">{{ copy.hero_kicker }}</p>
      {% include 'heroes/_facts.j2' %}
    </div>
  </div>
  <div class="container lsil-below">
    <h1 id="hero-title">{{ copy.hero_headline }}</h1>
    <p class="lsil-lede">{{ copy.hero_lede }}</p>
  </div>
  <div class="hero-dateband">
    <div class="container">
      <p class="lsil-datefine">{{ copy.date_title }}</p>
      {% include 'partials/date-inline.j2' %}
    </div>
  </div>
</section>

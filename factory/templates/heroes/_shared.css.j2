  /* shared by the 2B heroes: fact list, the date band under the photo (contract 4.3), inline date row */
  .hero-facts { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .hero-facts li { display: flex; align-items: baseline; gap: 8px; color: var(--ink-soft); font-size: 15.5px; }
  .hero-facts b { font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(24px, 2vw, 30px); line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; {% if pair.display.vars %}font-optical-sizing: none; font-variation-settings: {{ pair.display.vars|safe }};{% endif %} }
  .hero-facts span { letter-spacing: 0.02em; }
  .hero-dateband { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper); }
  .hero-dateband > .container { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.7fr); gap: clamp(20px, 3vw, 56px); align-items: center; padding-top: clamp(18px, 2.2vw, 28px); padding-bottom: clamp(18px, 2.2vw, 28px); }
  .hero-dateband .date-inline { margin: 0; }
  .date-row { display: grid; grid-template-columns: 1.1fr 0.7fr 1.3fr auto; gap: 10px; align-items: end; }
  .date-row .field { margin: 0; }
  .date-row .btn { min-height: 48px; }
  .date-row .date-err { grid-column: 1 / -1; margin: 0; }
  .date-inline .date-fine { margin-top: 10px; }
  .date-inline .confirm h3 { font-size: 24px; }
  @media (max-width: 1024px) {
    .hero-dateband > .container { grid-template-columns: 1fr; gap: 18px; }
  }
  @media (max-width: 860px) {
    .date-row { grid-template-columns: 1fr 1fr; }
    .date-row .btn { grid-column: 1 / -1; }
    .hero-facts { gap: 10px 20px; }
  }
  @media (max-width: 600px) {
    .date-row { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero [data-motion-device], .hero .hero-anim { animation: none !important; transition: none !important; opacity: 1 !important; transform: none !important; }
  }

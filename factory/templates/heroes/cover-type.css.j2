  /* hero: typographic cover */
  .hero-cover { padding: clamp(32px, 5vw, 64px) 0 clamp(40px, 6vw, 80px); }
  .cover-kicker { font-size: 13.5px; color: var(--ink-soft); font-weight: {{ pair.body.medium }}; margin-bottom: clamp(20px, 3vw, 36px); }
  .cover-h1 { font-size: clamp(42px, 8.6vw, 132px); line-height: 0.96; letter-spacing: -0.035em; max-width: 12ch; }
  .cover-h1 em { font-style: normal; color: var(--ink-faint); font-weight: {{ pair.display.italic_weight }}; }
  .cover-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); align-items: start; margin-top: clamp(32px, 5vw, 64px); }
  .cover-ledger .lede { font-size: clamp(17px, 1.4vw, 20px); max-width: 44ch; }
  .ledger { display: grid; grid-template-columns: 1fr 1fr; margin-top: 28px; border-top: 1px solid var(--ink); }
  .ledger div { display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .ledger div:nth-child(odd) { margin-right: 14px; } .ledger div:nth-child(even) { margin-left: 14px; }
  .ledger dt { color: var(--ink-soft); }
  .ledger dd { font-weight: {{ pair.body.medium }}; font-variant-numeric: tabular-nums; }
  .cover-fig { max-width: 560px; justify-self: end; width: 100%; }
  .cover-ph { aspect-ratio: 4 / 5; }
  .cover-ph img { aspect-ratio: 4 / 5; }
  .date-inline { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--ink); }
  .date-row { display: grid; grid-template-columns: 1.2fr 0.8fr 1.4fr; gap: 12px; align-items: end; }
  .date-row .field { margin: 0; }
  .date-row .btn { grid-column: 1 / -1; justify-self: start; min-height: 48px; min-width: 160px; }
  .date-row .date-err { grid-column: 1 / -1; margin: 0; }
  .date-inline .date-fine { margin-top: 10px; }
  @media (max-width: 860px) {
    .cover-grid { grid-template-columns: 1fr; }
    .cover-fig { justify-self: start; max-width: 100%; }
    .cover-ph, .cover-ph img { aspect-ratio: 4 / 3; }
    .date-row { grid-template-columns: 1fr; }
    .ledger { grid-template-columns: 1fr; }
    .ledger div { margin: 0 !important; }
  }

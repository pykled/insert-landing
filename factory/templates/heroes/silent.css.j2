  /* hero: silent (candlelit): the photo says it; the bar at the foot says the rest */
{% include 'heroes/_shared.css.j2' %}
  .hero-silent { padding: 0; }
  .silent-media { height: min(calc(100svh - 70px), 760px); min-height: 440px; overflow: hidden; background: var(--deep); position: relative; }
  .silent-media img { width: 100%; height: 100%; object-fit: cover; }
{% if t.photo_edge == 'keyline' or t.image_edge == 'keyline' %}
  .silent-media::after { content: ""; position: absolute; inset: 10px; border: 1px solid var(--metal, var(--line)); pointer-events: none; opacity: .9; }
{% endif %}
  .silent-foot { border-top: 1px solid var(--line); }
  .silent-bar { display: flex; align-items: center; justify-content: space-between; gap: clamp(20px, 3vw, 48px); padding-top: 22px; padding-bottom: 22px; }
{% with sel='.hero-silent h1', vw=2.6, maxpx=40, caps_vw=2.2 %}{% include 'heroes/_h1.css.j2' %}{% endwith %}
  .hero-silent h1 { max-width: 28ch; }
  @media (max-width: 600px) { .hero-silent h1 { font-size: clamp({{ [pair.display.min_px, 28]|max }}px, 7.5vw, 40px); } }
  .silent-meta { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: {{ pair.body.medium }}; color: var(--ink-soft); }
  .silent-meta b { font-weight: {{ pair.body.medium }}; color: var(--metal, var(--ink)); }
  .silent-inquire, .silent-inquire:hover { flex: 0 0 auto; border-radius: 0; border: 1px solid var(--metal, var(--ink)); color: var(--metal, var(--ink)); background: transparent; padding: 14px 28px; font-size: 13.5px; letter-spacing: 0.14em; text-transform: uppercase; }
  .silent-inquire:hover { background: var(--metal, var(--ink)); color: var(--on-accent, var(--paper)); }
  .silent-lede { font-size: clamp(17px, 1.3vw, 19px); color: var(--ink-soft); max-width: 44ch; }
  @media (max-width: 860px) {
    .silent-media { height: min(72svh, 560px); min-height: 360px; }
    .silent-bar { flex-direction: column; align-items: flex-start; }
    .silent-inquire { width: 100%; }
  }

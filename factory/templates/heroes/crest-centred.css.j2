  /* hero: crest-centred (estate) */
{% include 'heroes/_shared.css.j2' %}
{% set sec = pair.secondary if pair.secondary else None %}
{% set subw = sec.weight if sec else pair.display.weight %}
{% set subfam = sec.family if sec else pair.display.family %}
{# thin 400-weight faces fail the hairline probe below 48 px (56 for Forum / Libre Caslon Display / Italiana / Instrument Serif, measured by the base maker) #}
{% set subfloor = (56 if subfam in ('Forum', 'Libre Caslon Display', 'Italiana', 'Instrument Serif') else 48) if (subw <= 400 and (sec.min_px if sec else pair.display.min_px) >= 36) else [(sec.min_px if sec else pair.display.min_px), 24]|max %}
{# 2D: the measured floor of the face that sets the headline (pairings.json hairline_floor_px) wins over the rule above #}
{% set subface = sec if sec else pair.display %}
{% if subface.hairline_floor_px is defined %}{% set subfloor = subface.hairline_floor_px %}{% endif %}
  .hero-crest { padding: 0; }
  .crest-stage { position: relative; min-height: min(80vh, 740px); display: grid; align-items: center; isolation: isolate; color: var(--on-photo, #fff); text-align: center; }
  .crest-media { position: absolute; inset: 0; z-index: -2; overflow: hidden; background: transparent; }
  .crest-media img { width: 100%; height: 100%; object-fit: cover; }
  /* two soft gradients (vertical 10 -> 35%, a radial pool under the centred copy 35 -> 0), no stop above 35% (E9) */
  .crest-stage::after { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background:
    radial-gradient(ellipse 60% 55% at 50% 56%, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.22) 45%, rgba(0,0,0,0) 100%),
    linear-gradient(180deg, rgba(0,0,0,0.10) 0%, rgba(0,0,0,0.26) 45%, rgba(0,0,0,0.35) 100%); }
  .crest-copy { padding-top: clamp(72px, 10vh, 120px); padding-bottom: clamp(56px, 8vh, 96px); display: grid; justify-items: center; gap: 0; max-width: 100%; min-width: 0; }
  .crest-copy > * { max-width: 100%; min-width: 0; }
  .crest-mark { min-height: 0; margin-bottom: 22px; display: grid; place-items: center; color: var(--metal, var(--on-photo, #fff)); }
  .crest-mark:empty { display: none; }
  .crest-name { font-family: var(--display); font-weight: var(--display-weight); text-transform: uppercase; letter-spacing: 0.2em; text-indent: 0.2em; line-height: 1.15; font-size: clamp({{ [pair.display.min_px, 26]|max }}px, 3.2vw, {{ 46 if (pair.display.weight <= 400 and pair.display.min_px >= 36) else 40 }}px); color: var(--on-photo, #fff); text-wrap: balance; }
  .crest-sub { margin-top: 18px; letter-spacing: 0; text-wrap: balance; font-family: {{ ("'" ~ sec.family ~ "', " ~ sec.fallback)|safe if sec else 'var(--display)' }}; font-weight: {{ sec.italic_weight if sec else pair.display.italic_weight }}; font-style: italic; font-size: clamp({{ subfloor }}px, 2.6vw, {{ [subfloor, 38]|max }}px); line-height: 1.2; color: var(--on-photo, #fff); max-width: 30ch; text-wrap: balance; {% if sec %}font-variation-settings: normal;{% elif pair.display.vars %}font-optical-sizing: none; font-variation-settings: {{ pair.display.vars|safe }};{% endif %} }
  .crest-sub em { font-style: italic; font-weight: inherit; }
  .crest-loc { margin-top: 16px; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: {{ pair.body.medium }}; color: var(--on-photo, #fff); }
  .crest-actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 30px; }
  .crest-btn, .crest-btn:hover { border-radius: 0; border: 1px solid var(--on-photo, #fff); background: transparent; color: var(--on-photo, #fff); padding: 14px 26px; font-size: 13.5px; letter-spacing: 0.12em; text-transform: uppercase; min-width: 180px; }
  .crest-btn:hover { background: var(--on-photo, #fff); color: var(--ink); }
  .crest-lede { font-size: clamp(17px, 1.3vw, 19px); color: var(--ink-soft); max-width: 48ch; margin-bottom: 14px; }
  .crest-copy .hero-anim { animation: crestFade 1s var(--ease) both; }
  .crest-copy .hero-anim:nth-child(2) { animation-delay: .1s; } .crest-copy .hero-anim:nth-child(3) { animation-delay: .2s; } .crest-copy .hero-anim:nth-child(4) { animation-delay: .3s; } .crest-copy .hero-anim:nth-child(5) { animation-delay: .4s; }
  @keyframes crestFade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (max-width: 860px) {
    /* copy moves onto paper under the photo: a 35% scrim cannot carry centred copy on a daylight lead at 390px */
    .crest-stage { display: block; min-height: 0; color: var(--ink); }
    .crest-stage::after { display: none; }
    .crest-media { position: relative; inset: auto; z-index: 0; height: min(60svh, 480px); min-height: 300px; }
    .crest-mark { color: var(--metal, var(--accent-text)); }
    .hero-crest .orn-crest-hero .orn-crest-svg { color: var(--metal, var(--accent)); }
    .hero-crest .orn-crest-hero .orn-crest-text { color: var(--accent-text); }
    .crest-name, .crest-sub { color: var(--ink); }
    .crest-loc { color: var(--ink-soft); }
    .crest-btn, .crest-btn:hover { border-color: var(--ink); color: var(--ink); }
    .crest-btn:hover { background: var(--ink); color: var(--paper); }
    .crest-name { font-size: clamp({{ [pair.display.min_px, 22]|max }}px, 7.4vw, 40px); letter-spacing: {{ '0.06em' if v.short_name|length > 9 else '0.14em' }}; text-indent: 0; overflow-wrap: anywhere; }
    .crest-sub { --h1-size: clamp({{ [(sec.min_px if sec else pair.display.min_px), 22]|max }}px, 6.4vw, 30px); font-size: var(--h1-size); }
    .crest-copy { padding-top: 40px; padding-bottom: 40px; }
    .crest-actions { flex-direction: column; align-items: stretch; width: min(100%, 320px); }
  }
{% if hero_copy_on == 'paper' %}
  /* paper mode (stage 2C): build.py measured the lead too bright for copy under the 35% scrim cap
     (lib/palette.copy_zone_contrast), so the photo stands alone as a band and the crest block sits on paper at every
     width, like the mobile layout. The facts move into the crest block so they stay in the first screen (E19). */
  .crest-on-paper .crest-stage { display: block; min-height: 0; color: var(--ink); }
  .crest-on-paper .crest-stage::after { display: none; }
  .crest-on-paper .crest-media { position: relative; inset: auto; z-index: 0; height: clamp(300px, 46vh, 460px); }
  .crest-on-paper .crest-mark { color: var(--metal, var(--accent-text)); margin-bottom: 16px; }
  .crest-on-paper .orn-crest-hero .orn-crest-svg { color: var(--metal, var(--accent)); }
  .crest-on-paper .orn-crest-hero .orn-crest-text { color: var(--accent-text); }
  .crest-on-paper .crest-name, .crest-on-paper .crest-sub { color: var(--ink); }
  .crest-on-paper .crest-loc { color: var(--ink-soft); }
  .crest-on-paper .crest-btn, .crest-on-paper .crest-btn:hover { border-color: var(--ink); color: var(--ink); }
  .crest-on-paper .crest-btn:hover { background: var(--ink); color: var(--paper); }
  .crest-on-paper .crest-copy { padding-top: clamp(36px, 5vh, 56px); padding-bottom: clamp(36px, 5vh, 56px); }
  .crest-on-paper .crest-sub { margin-top: 12px; }
  .crest-on-paper .crest-facts { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); }
  .crest-on-paper .crest-facts .hero-facts { justify-content: center; }
  .crest-on-paper .crest-actions { margin-top: 24px; }
{% endif %}
  @media (prefers-reduced-motion: reduce) {
    .crest-copy .hero-anim { animation: none; opacity: 1; transform: none; }
  }

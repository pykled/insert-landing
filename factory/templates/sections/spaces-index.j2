<section id="spaces" class="spaces-index" aria-labelledby="spaces-title">
  <div class="container">
    <div class="section-head">
      <p class="kicker reveal">{{ copy.spaces_kicker }}</p>
      <h2 id="spaces-title" class="reveal d1">{{ copy.spaces_title }}</h2>
      {% if copy.spaces_lede %}<p class="lede reveal d2">{{ copy.spaces_lede }}</p>{% endif %}
    </div>
    <div class="index-grid">
      <ol class="index-list" id="index-list">
        {% for s in v.spaces %}
        <li class="index-row" data-photo="{{ s.photo }}" {% if loop.first %}data-active{% endif %} tabindex="0" id="space-{{ s.id }}">
          <span class="num">{{ '%02d' % loop.index }}</span>
          <div class="index-body">
            <h3>{{ s.name }}</h3>
            <p class="use">{{ s.use }}</p>
            <p class="blurb">{{ s.blurb }}</p>
          </div>
          {% if s.capacity_label %}<span class="capn">{{ s.capacity_label }}</span>{% endif %}
          <div class="ph row-ph"><img src="{{ photos[s.photo].src }}" srcset="{{ photos[s.photo].srcset }}" sizes="{{ '100vw'|cover(photos[s.photo], '3 / 2') }}" width="{{ photos[s.photo].width }}" height="{{ photos[s.photo].height }}" alt="{{ photos[s.photo].alt }}" style="object-position: {{ photos[s.photo].focal }}" loading="lazy" decoding="async"></div>
        </li>
        {% endfor %}
      </ol>
      <div class="index-stage" aria-hidden="true">
        {# 3A item 5: one stage box for every space photo; its ratio follows the widest photo so none is drawn past MAX_CROP #}
        {% set ns = namespace(ph=photos[v.spaces[0].photo]) %}{% for s in v.spaces %}{% if photos[s.photo].width / photos[s.photo].height > ns.ph.width / ns.ph.height %}{% set ns.ph = photos[s.photo] %}{% endif %}{% endfor %}
        {% set _ar = fit_ratio(ns.ph, '4 / 5') %}
        <div class="ph stage-ph" style="--ar: {{ _ar }}">
          {% for s in v.spaces %}<img class="stage-img{% if loop.first %} on{% endif %}" data-photo="{{ s.photo }}" src="{{ photos[s.photo].src }}" srcset="{{ photos[s.photo].srcset }}" sizes="{{ '(min-width: 861px) 44vw, 1px'|cover(photos[s.photo], _ar) }}" width="{{ photos[s.photo].width }}" height="{{ photos[s.photo].height }}" alt="" style="object-position: {{ photos[s.photo].focal }}" loading="{{ 'eager' if loop.first else 'lazy' }}"{% if loop.first %} fetchpriority="low"{% endif %} decoding="async">{% endfor %}
        </div>
        <p class="stage-cap" id="stage-cap">{{ v.spaces[0].name }}</p>
      </div>
    </div>
  </div>
</section>

{% if dialect and bottom %}
{% include 'bottoms/' ~ bottom ~ '-uses.j2' %}
{% else %}
<section class="uses" aria-label="{{ secondary_uses_sentence }}" id="uses">
  <div class="container">
    <div class="uses-band {{ 'band-ink' if uses_band == 'ink' else 'band-deep' }} reveal">
      <div>
        <h2>{{ secondary_uses_sentence }}.</h2>
        <p>{{ v.tagline_facts.space_count }} distinct looks on one private property: {{ looks_sentence }}. Tell us about {{ 'the shoot or the celebration' if uses_shoot else 'your event' }} and we'll come back with dates.</p>
      </div>
      <a class="btn btn-light" href="mailto:{{ v.contact.email }}?subject={{ 'Filming%20or%20private%20event' if uses_shoot else 'Private%20event' }}">Email about {{ 'a shoot or event' if uses_shoot else 'your event' }}</a>
    </div>
  </div>
</section>{% endif %}

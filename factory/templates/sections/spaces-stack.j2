<section id="spaces" class="spaces-stack" aria-labelledby="spaces-title">
  <div class="container">
    <div class="section-head">
      <p class="kicker reveal">{{ copy.spaces_kicker }}</p>
      <h2 id="spaces-title" class="reveal d1">{{ copy.spaces_title }}</h2>
      {% if copy.spaces_lede %}<p class="lede reveal d2">{{ copy.spaces_lede }}</p>{% endif %}
    </div>
    <div class="stack">
      {% for s in v.spaces %}
      <article class="stack-row reveal" id="space-{{ s.id }}">
        <div class="ph stack-ph">
          <img src="{{ photos[s.photo].src }}" srcset="{{ photos[s.photo].srcset }}" sizes="(min-width: 861px) 52vw, 100vw" width="{{ photos[s.photo].width }}" height="{{ photos[s.photo].height }}" alt="{{ photos[s.photo].alt }}" style="object-position: {{ photos[s.photo].focal }}" loading="lazy" decoding="async">
          {% if s.capacity_label %}<span class="cap">{{ s.capacity_label }}</span>{% endif %}
        </div>
        <div class="stack-body">
          <p class="num">{{ loop.index }} <span>of {{ v.spaces|length }}</span></p>
          <h3>{{ s.name }}</h3>
          <p class="blurb">{{ s.blurb }}</p>
          {% if s.features %}<ul class="chips">{% for f in s.features %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

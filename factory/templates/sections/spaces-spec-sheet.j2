<section id="spaces" class="spaces-spec" aria-labelledby="spaces-title">
  <div class="container">
    <div class="spec-head">
      <h2 id="spaces-title">{{ copy.spaces_title }}</h2>
      {% if copy.spaces_lede %}<p class="lede">{{ copy.spaces_lede }}</p>{% endif %}
    </div>
    <table class="spec">
      <thead><tr><th scope="col" class="th-img"><span class="sr-only">Photo</span></th><th scope="col">Space</th><th scope="col">Use</th><th scope="col" class="th-cap">Capacity</th><th scope="col">Notes</th></tr></thead>
      <tbody>
        {% for s in v.spaces %}
        <tr id="space-{{ s.id }}">
          <td class="td-img"><div class="ph spec-ph"><img src="{{ photos[s.photo].src }}" srcset="{{ photos[s.photo].srcset }}" sizes="(min-width: 861px) 112px, 100vw" width="{{ photos[s.photo].width }}" height="{{ photos[s.photo].height }}" alt="{{ photos[s.photo].alt }}" style="object-position: {{ photos[s.photo].focal }}" loading="lazy" decoding="async"></div></td>
          <th scope="row"><span class="spec-n">{{ '%02d' % loop.index }}</span>{{ s.name }}</th>
          <td data-label="Use">{{ s.use }}</td>
          <td data-label="Capacity" class="td-cap">{{ s.capacity_label or '—' }}</td>
          <td data-label="Notes">{{ (s.features or [])|join(' · ') or '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="fine spec-foot">{% if v.day.spaces_per_event %}{{ v.day.spaces_per_event }}. {% endif %}Capacities as published by the venue.</p>
  </div>
</section>

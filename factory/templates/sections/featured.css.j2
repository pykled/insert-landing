  .featured { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 20px 0; }
  .featured .container { display: flex; align-items: center; gap: 16px 30px; flex-wrap: wrap; justify-content: center; }
  .featured small { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft); font-weight: {{ pair.body.medium }}; }
  .featured ul { display: flex; gap: 10px 26px; flex-wrap: wrap; list-style: none; justify-content: center; }
  .featured li { font-family: var(--h3-font); font-size: 16.5px; color: var(--ink-soft); }

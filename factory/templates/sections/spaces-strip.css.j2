  /* spaces: hairlined strip (modern-luxe) */
{% set strip_cols = [v.spaces|length, 6]|min %}
  .strip-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: end; margin-bottom: clamp(32px, 4vw, 56px); }
  .strip { display: grid; grid-template-columns: repeat({{ strip_cols }}, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .strip-item { padding: 28px 24px 32px 0; border-bottom: 1px solid var(--line); border-left: 1px solid var(--line); padding-left: 24px; min-width: 0; }
  .strip-item:nth-child({{ strip_cols }}n+1) { border-left: 0; padding-left: 0; }
  .strip-ph { aspect-ratio: 4 / 5; }
  .strip-ph img { aspect-ratio: 4 / 5; }
  .strip-cap { margin-top: 18px; font-size: 12.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-faint); font-weight: {{ pair.body.medium }}; font-variant-numeric: tabular-nums; }
  .strip-n { color: var(--accent-text); margin-right: 12px; }
  .strip-item h3 { font-size: clamp(20px, 1.6vw, 24px); margin-top: 10px; }
  .strip-use { color: var(--ink-soft); font-size: 16.5px; margin-top: 8px; max-width: 30ch; }
  .strip-notes { margin-top: 10px; max-width: 30ch; }
  .strip-foot { margin-top: 18px; }
  @media (max-width: 1099px) {
    .strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .strip-item:nth-child(n) { border-left: 1px solid var(--line); padding-left: 24px; }
    .strip-item:nth-child(3n+1) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 860px) {
    .strip-head { grid-template-columns: 1fr; }
    .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .strip-item { padding-right: 16px; }
    .strip-item:nth-child(n) { border-left: 1px solid var(--line); padding-left: 16px; }
    .strip-item:nth-child(2n+1) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 480px) {
    .strip { grid-template-columns: 1fr; }
    .strip-item:nth-child(n) { border-left: 0; padding-left: 0; padding-right: 0; }
    .strip-ph { max-width: 320px; }
  }

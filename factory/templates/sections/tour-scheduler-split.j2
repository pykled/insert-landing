<section id="tour" class="tour-split" aria-labelledby="tour-title">
  <div class="container sched-grid">
    <div>
      <div class="section-head">
        <p class="kicker reveal">{{ copy.tour_kicker }}</p>
        <h2 id="tour-title" class="reveal d1">{{ copy.tour_title }}</h2>
        {% if copy.tour_lede %}<p class="lede reveal d2">{{ copy.tour_lede }}</p>{% endif %}
      </div>
      <ul class="sched-notes reveal d3">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>Walk all {{ v.tagline_facts.space_count }} spaces, from the barn at the gate to the bungalow.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8-8-2z"/></svg><span>{{ v.contact.address_line }}, {{ v.tagline_facts.locality }}. Directions arrive with your confirmation.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="M4 9h16M9 4v16"/></svg><span>Bring your planner if you have one.{% if v.day.requirement %} {{ v.day.requirement }}.{% endif %}</span></li>
      </ul>
    </div>
    {% include 'partials/scheduler.j2' %}
  </div>
</section>

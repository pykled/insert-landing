  .tour-centered .section-head.centered { text-align: center; margin-left: auto; margin-right: auto; }
  .tour-centered .centered .kicker { justify-content: center; width: fit-content; max-width: 100%; margin-left: auto; margin-right: auto; }
  .tour-centered .centered .lede { margin-left: auto; margin-right: auto; }
  .tour-wrap { max-width: 680px; margin: 0 auto; }
  .tour-notes { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 980px; margin: 36px auto 0; padding-top: 24px; border-top: 1px solid var(--line); font-size: 15px; color: var(--ink-soft); }
  @media (max-width: 860px) { .tour-notes { grid-template-columns: 1fr; } }

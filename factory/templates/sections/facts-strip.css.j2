  /* facts strip: one hairlined row of numerals under the hero */
{% set num_in_body = pair.display.name_and_one_headline_only or pair.display.one_headline_per_page %}
{% set fact_label = 'var(--metal, var(--accent-text))' if palette_mode == 'dark' else 'var(--accent-text)' %}
{% set fact_rule = 'color-mix(in srgb, var(--metal, var(--line)) 45%, transparent)' if palette_mode == 'dark' else 'var(--line)' %}
  .facts-strip { padding: clamp(28px, 4vw, 56px) 0; }
  .facts-row { list-style: none; display: grid; grid-template-columns: repeat(var(--facts-n, 4), minmax(0, 1fr)); border-top: 1px solid {{ fact_rule }}; border-bottom: 1px solid {{ fact_rule }}; }
  .facts-item { padding: clamp(22px, 2.6vw, 34px) 20px; border-left: 1px solid {{ fact_rule }}; text-align: center; min-width: 0; }
  .facts-item:first-child { border-left: 0; }
{% if num_in_body %}
  .facts-item b { display: block; font-family: var(--body); font-weight: {{ pair.body.medium }}; font-size: clamp(32px, 3.4vw, 46px); line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
{% else %}
  .facts-item b { display: block; font-family: var(--display); font-weight: var(--display-weight); font-size: max({{ pair.display.min_px }}px, clamp(38px, 3.8vw, 54px)); line-height: 1; color: var(--ink); font-variant-numeric: lining-nums tabular-nums; letter-spacing: {{ pair.display.tracking }}; {% if pair.display.vars %}font-optical-sizing: none; font-variation-settings: {{ pair.display.vars|safe }};{% endif %} }
{% endif %}
{% if t.kicker_style == 'italic' %}
  .facts-item span { display: block; margin-top: 10px; font-family: var(--display); font-style: italic; font-weight: {{ pair.display.italic_weight }}; font-size: max({{ [pair.display.min_px, 17]|min }}px, 17px); color: {{ fact_label }}; {% if pair.display.vars %}font-optical-sizing: none; font-variation-settings: {{ pair.display.vars|safe }};{% endif %} }
{% elif t.kicker_style == 'small-caps' %}
  .facts-item span { display: block; margin-top: 10px; font-size: 15px; font-variant: small-caps; letter-spacing: 0.14em; color: {{ fact_label }}; font-weight: {{ pair.body.medium }}; }
{% else %}
  .facts-item span { display: block; margin-top: 10px; font-size: 12.5px; letter-spacing: {{ '0.2em' if (dialect and dialect.id == 'deco') else '0.16em' }}; text-transform: uppercase; color: {{ fact_label }}; font-weight: {{ pair.body.medium }}; }
{% endif %}
  @media (max-width: 860px) {
    .facts-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts-item { padding: 22px 12px; border-bottom: 1px solid {{ fact_rule }}; }
    .facts-item:nth-child(2n+1) { border-left: 0; }
    .facts-item:nth-last-child(-n+2):nth-child(2n+1), .facts-item:last-child { border-bottom: 0; }
    .facts-row { border-bottom: 1px solid {{ fact_rule }}; }
  }

  /* story: timeline rail */
  .tl-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .tl-paras { margin-top: 24px; }
  .tl-paras p { color: var(--ink-soft); font-size: 17px; margin-bottom: 16px; max-width: 58ch; }
  .tl-paras cite { display: block; font-style: normal; font-size: 13px; color: var(--ink-faint); }
  .rail { list-style: none; margin-top: 36px; border-left: 2px solid var(--accent); }
  .rail li { position: relative; padding: 0 0 22px 26px; color: var(--ink-soft); font-size: 16px; }
  .rail li::before { content: ""; position: absolute; left: -7px; top: 8px; width: 12px; height: 12px; border-radius: 50%; background: var(--paper-2); border: 2px solid var(--accent); }
  .rail time { display: block; font-family: var(--display); font-weight: var(--display-weight); font-size: 22px; color: var(--ink); margin-bottom: 4px; {% if pair.display.vars %}font-optical-sizing: none; font-variation-settings: {{ pair.display.vars|safe }};{% endif %} }
  .tl-media { max-width: 400px; justify-self: end; width: 100%; position: sticky; top: 100px; }
  .tl-ph { aspect-ratio: 3 / 4; box-shadow: var(--shadow); }
  .tl-ph img { aspect-ratio: 3 / 4; }
  @media (max-width: 860px) {
    .tl-grid { grid-template-columns: 1fr; }
    .tl-media { position: static; justify-self: start; }
  }

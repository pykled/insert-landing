  /* story: split (port of the Stonehurst mock) */
{% set lead_face = pair.secondary if (pair.display.caps_only and pair.secondary) else pair.display %}
{% set lead_in_body = pair.display.name_and_one_headline_only or pair.display.one_headline_per_page %}
  .story-split .story-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .story-text { position: relative; }
  .story-text > [data-ornament] { position: absolute; z-index: 0; pointer-events: none; }
  .story-text > :not([data-ornament]) { position: relative; z-index: 1; }
  .story-copy { margin-top: 26px; }
  .story-copy p { margin-bottom: 18px; font-size: clamp(17px, 1.3vw, 19px); color: var(--ink-soft); max-width: 58ch; }
{% if lead_in_body %}
  .story-copy p.story-lead-in { font-size: clamp(20px, 1.8vw, 24px); line-height: 1.4; color: var(--ink); max-width: 48ch; }
{% else %}
  .story-copy p.story-lead-in { font-family: '{{ lead_face.family }}', {{ lead_face.fallback|safe }}; font-weight: {{ lead_face.weight }}; font-size: max({{ lead_face.min_px }}px, clamp(24px, 2.4vw, 32px)); line-height: 1.3; letter-spacing: {{ lead_face.tracking }}; color: var(--ink); max-width: 40ch; {% if lead_face.vars %}font-optical-sizing: none; font-variation-settings: {{ lead_face.vars|safe }};{% endif %} }
{% endif %}
  /* the mock set this in tracked caps; credits run past 60 characters (E5), so: small, plain, letter-spaced lightly */
  .story-copy cite { display: block; font-style: normal; font-size: 13.5px; letter-spacing: 0.03em; color: var(--ink-faint); margin-top: 8px; max-width: 48ch; }
  .story-media { max-width: 440px; justify-self: end; width: 100%; position: relative; }
  .story-frame { position: relative; display: block; }
  .story-ph { display: block; aspect-ratio: 3 / 4; }
  .story-ph img { aspect-ratio: 3 / 4; }
  .story-frame::before { content: ""; position: absolute; inset: 18px -18px -18px 18px; border: 1px solid var(--metal, var(--line-strong)); border-radius: var(--radius-img); z-index: 0; pointer-events: none; }
  .story-frame .ph { z-index: 1; }
  .story-media figcaption { margin-top: 34px; letter-spacing: 0.02em; }
  .story-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: clamp(48px, 6vw, 80px); padding-top: 36px; border-top: 1px solid var(--line); }
  .story-fact b { display: block; font-family: var(--display); font-weight: var(--display-weight); font-size: max({{ pair.display.min_px }}px, clamp(40px, 4vw, 56px)); line-height: 1; color: var(--ink); {% if pair.display.vars %}font-optical-sizing: none; font-variation-settings: {{ pair.display.vars|safe }};{% endif %} }
  .story-fact span { display: block; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); font-weight: {{ pair.body.medium }}; margin-top: 8px; }
  @media (max-width: 860px) {
    .story-split .story-grid { grid-template-columns: 1fr; }
    .story-media { margin-top: 10px; justify-self: start; max-width: 100%; }
    .story-frame::before { inset: 12px -12px -12px 12px; }
    .story-facts { grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
  }
  @media (max-width: 420px) {
    .story-facts { grid-template-columns: 1fr; gap: 20px; }
  }

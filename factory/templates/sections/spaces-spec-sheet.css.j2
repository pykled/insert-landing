  /* spaces: spec sheet */
  .spec-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: end; margin-bottom: 32px; }
  .spec { width: 100%; border-collapse: collapse; border-top: 1px solid var(--ink); }
  .spec th, .spec td { text-align: left; vertical-align: top; padding: 18px 16px 18px 0; border-bottom: 1px solid var(--line); font-size: 15.5px; }
  .spec thead th { font-size: 12.5px; color: var(--ink-faint); font-weight: {{ pair.body.medium }}; padding: 12px 16px 12px 0; letter-spacing: 0.02em; }
  .spec tbody th { font-weight: {{ pair.body.medium }}; font-size: 17px; white-space: nowrap; }
  .spec-n { display: inline-block; width: 34px; color: var(--ink-faint); font-weight: {{ pair.body.weight }}; font-variant-numeric: tabular-nums; }
  .spec td { color: var(--ink-soft); }
  .td-cap { white-space: nowrap; color: var(--ink) !important; font-variant-numeric: tabular-nums; }
  .td-img { width: 128px; }
  .spec-ph { width: 112px; aspect-ratio: 1; }
  .spec-ph img { aspect-ratio: 1; }
  .spec-foot { margin-top: 16px; }
  @media (max-width: 860px) {
    .spec-head { grid-template-columns: 1fr; }
    .spec thead { display: none; }
    .spec, .spec tbody, .spec tr, .spec td, .spec tbody th { display: block; }
    .spec tr { padding: 18px 0; border-bottom: 1px solid var(--line); }
    .spec td, .spec tbody th { border: 0; padding: 4px 0; }
    .spec tbody th { padding-top: 12px; }
    .spec td[data-label]::before { content: attr(data-label) ": "; color: var(--ink-faint); }
    .td-img { width: auto; }
    .spec-ph { width: 100%; aspect-ratio: 3 / 2; }
    .spec-ph img { aspect-ratio: 3 / 2; }
  }

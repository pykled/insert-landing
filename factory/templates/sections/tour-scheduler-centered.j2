<section id="tour" class="tour-centered" aria-labelledby="tour-title">
  <div class="container">
    <div class="section-head centered">
      <p class="kicker reveal">{{ copy.tour_kicker }}</p>
      <h2 id="tour-title" class="reveal d1">{{ copy.tour_title }}</h2>
      {% if copy.tour_lede %}<p class="lede reveal d2">{{ copy.tour_lede }}</p>{% endif %}
    </div>
    <div class="tour-wrap">
      {% include 'partials/scheduler.j2' %}
    </div>
    <ul class="tour-notes reveal d3">
      {% if v.spaces|length > 1 %}<li>Walk {{ 'all ' ~ v.tagline_facts.space_count ~ ' spaces' if v.tagline_facts.space_count else 'every space' }}.</li>{% endif %}
      {% if v.contact.address_line %}<li>{% set ad = v.contact.address_line %}{% if ad %}{{ ad }}{% if v.tagline_facts.locality not in ad %}, {{ v.tagline_facts.locality }}{% endif %}.{% endif %}</li>{% endif %}
      {% if v.day.requirement %}<li>{{ v.day.requirement }}.</li>{% endif %}
    </ul>
  </div>
</section>

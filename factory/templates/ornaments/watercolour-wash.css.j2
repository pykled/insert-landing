  /* ornament: watercolour-wash (page): the one gradient E11 allows, radial, <= 8% alpha, behind the statement */
  body[data-ornament="watercolour-wash"] #statement, body[data-ornament="watercolour-wash"] .statement-wash { background-image: radial-gradient(ellipse 58% 70% at 50% 48%, color-mix(in srgb, var(--accent-tint) 8%, transparent), transparent 72%); background-repeat: no-repeat; }
  body[data-ornament="watercolour-wash"] .arch-copy, body[data-ornament="watercolour-wash"] .wash { background-image: radial-gradient(ellipse 70% 60% at 40% 50%, color-mix(in srgb, var(--accent-tint) 8%, transparent), transparent 72%); background-repeat: no-repeat; }

  /* ornament: rope-rule: 8 px dashes, 8 px gaps, 1 px tall (the element carries data-ornament, so E11 reads it as a device) */
  .orn-rope { width: 160px; height: 1px; margin: 18px 0 0; background-image: repeating-linear-gradient(90deg, var(--accent) 0 8px, transparent 8px 16px); }
  .orn-rope.orn-center { margin-left: auto; margin-right: auto; }
  .orn-rope-divider { width: min(var(--max), calc(100% - 2 * var(--gutter))); margin: 0 auto; position: relative; z-index: 2; }

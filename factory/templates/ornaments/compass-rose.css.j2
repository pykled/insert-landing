  /* ornament: compass-rose */
  .orn-compass { display: flex; justify-content: center; padding: 0 0 36px; color: var(--accent-text); line-height: 0; }
  .orn-compass path, .orn-compass circle { fill: none; stroke: currentColor; stroke-width: 1; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .orn-compass circle { fill: currentColor; }
  .orn-compass-axis { opacity: .55; }
  .orn-compass-diag { opacity: .35; stroke-dasharray: 2 3; }

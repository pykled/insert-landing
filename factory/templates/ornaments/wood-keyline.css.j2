  /* ornament: wood-keyline (page): warm-brown = the accent text colour mixed toward ink, from tokens only */
  body[data-ornament="wood-keyline"] .ph { border-radius: 0; }
  body[data-ornament="wood-keyline"] .ph img { border-radius: 0; }
  body[data-ornament="wood-keyline"] .ph::after { content: ""; position: absolute; inset: 6px; border: 1px solid color-mix(in srgb, var(--accent-text) 72%, var(--ink)); pointer-events: none; }

  /* ornament: double-line-frame */
  .orn-dlf { position: absolute; inset: 0; pointer-events: none; color: var(--metal, var(--accent)); }
  .orn-dlf svg { position: absolute; overflow: visible; display: block; }
  .orn-dlf-outer { inset: 12px; width: calc(100% - 24px); height: calc(100% - 24px); }
  .orn-dlf-inner { inset: 20px; width: calc(100% - 40px); height: calc(100% - 40px); }
  .orn-dlf rect { fill: none; stroke: currentColor; stroke-width: 1; shape-rendering: crispEdges; stroke-dasharray: 1; stroke-dashoffset: 0; }
  /* 2C: a frame drawn over a text block (story-split's story slot) needs the copy inset past the inner line
     (20px desktop / 14px phone) plus air, or the lines cut through the letters */
  .story-text:has(> .orn-dlf) { padding: clamp(40px, 4vw, 56px) clamp(36px, 4vw, 56px); }
  @media (max-width: 600px) { .story-text:has(> .orn-dlf) { padding: 34px 28px; } }
  @keyframes orn-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .orn-dlf rect { animation: orn-draw {{ t.motion_device_ms|default(1400) }}ms var(--ease) both; }
  .orn-dlf-inner rect { animation-delay: 120ms; }
  /* base marker: the tour band that follows gets the frame through its own box */
  .orn-dlf-marker { display: block; height: 0; }
  .orn-dlf-marker + section { position: relative; outline: 1px solid var(--metal, var(--accent)); outline-offset: -12px; }
  .orn-dlf-marker + section::after { content: ""; position: absolute; inset: 20px; border: 1px solid var(--metal, var(--accent)); pointer-events: none; z-index: 0; animation: orn-fade {{ t.motion_device_ms|default(1400) }}ms var(--ease) both; }
  @keyframes orn-fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .orn-dlf rect { animation: none; stroke-dashoffset: 0; } .orn-dlf-marker + section::after { animation: none; } }
  @media (max-width: 600px) { .orn-dlf-outer { inset: 8px; width: calc(100% - 16px); height: calc(100% - 16px); } .orn-dlf-inner { inset: 14px; width: calc(100% - 28px); height: calc(100% - 28px); } .orn-dlf-marker + section { outline-offset: -8px; } .orn-dlf-marker + section::after { inset: 14px; } }

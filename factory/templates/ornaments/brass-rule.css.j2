  /* ornament: brass-rule */
  .orn-brass { display: flex; align-items: center; gap: 10px; width: 120px; margin: 18px 0 0; color: var(--metal, var(--accent)); }
  .orn-brass i { flex: 1; height: 1px; background: currentColor; }
  .orn-brass b { width: 6px; height: 6px; background: currentColor; transform: rotate(45deg); flex: none; }
  .orn-brass.orn-center { margin-left: auto; margin-right: auto; }
  .orn-brass-divider { width: min(var(--max), calc(100% - 2 * var(--gutter))); margin: 0 auto; position: relative; z-index: 2; }
  .orn-brass-divider i { opacity: .6; }

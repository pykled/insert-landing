  /* ornament: sunburst */
  .orn-sun { display: flex; justify-content: center; padding: 0 0 36px; color: var(--metal, var(--accent)); line-height: 0; }
  .orn-sun path, .orn-sun circle { fill: none; stroke: currentColor; stroke-width: 1; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .orn-sun-core { fill: currentColor; }

  /* ornament: leaf-rule */
  .orn-leafrule { display: flex; align-items: center; gap: 10px; width: 160px; margin: 18px 0 0; color: var(--accent-text); }
  .orn-leafrule i { flex: 1; height: 1px; background: var(--line-strong, var(--line)); }
  .orn-leafrule svg { flex: none; }
  .orn-leafrule path { fill: none; stroke: currentColor; stroke-width: 1; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .orn-leafrule.orn-center { margin-left: auto; margin-right: auto; }
  .orn-leafrule-divider { width: min(var(--max), calc(100% - 2 * var(--gutter))); margin: 0 auto; position: relative; z-index: 2; }

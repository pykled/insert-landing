  /* ornament: geometric-rule: the chevron is a mask (geometry only); the colour is the brass token */
  .orn-geo { width: 100%; height: 8px; margin: 24px 0 0; background-color: var(--metal, var(--accent)); -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 6 8' width='6' height='8'><path d='M0 7 L3 1 L6 7' fill='none' stroke='black' stroke-width='1'/></svg>"); mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 6 8' width='6' height='8'><path d='M0 7 L3 1 L6 7' fill='none' stroke='black' stroke-width='1'/></svg>"); -webkit-mask-size: 6px 8px; mask-size: 6px 8px; -webkit-mask-repeat: repeat-x; mask-repeat: repeat-x; }
  .orn-geo-divider { width: min(var(--max), calc(100% - 2 * var(--gutter))); margin: 0 auto; position: relative; z-index: 2; }

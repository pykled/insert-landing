<section class="uses uses-lp" aria-label="{{ secondary_uses_sentence }}" id="uses" data-bottom="letterpress">
  <div class="container">
    <div class="lp-card reveal">
      {% if bottom_facts %}<p class="lp-label">{% for n, label in bottom_facts %}{{ n }} {{ label }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
      <h2>{{ secondary_uses_sentence }}.</h2>
      <p>{{ v.tagline_facts.space_count }} distinct looks on one private property: {{ looks_sentence }}. Tell us about {{ 'the shoot or the celebration' if uses_shoot else 'your event' }} and we'll come back with dates.</p>
      <a class="btn" href="mailto:{{ v.contact.email }}?subject={{ 'Filming%20or%20private%20event' if uses_shoot else 'Private%20event' }}">Email about {{ 'a shoot or event' if uses_shoot else 'your event' }}</a>
    </div>
  </div>
</section>

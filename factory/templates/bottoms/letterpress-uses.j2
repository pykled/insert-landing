<section class="uses uses-lp" aria-label="Filming and private events" id="uses" data-bottom="letterpress">
  <div class="container">
    <div class="lp-card reveal">
      {% if bottom_facts %}<p class="lp-label">{% for n, label in bottom_facts %}{{ n }} {{ label }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
      <h2>{{ v.tagline_facts.uses[1:]|join(' and ')|capitalize }}.</h2>
      <p>{{ v.tagline_facts.space_count }} distinct looks on one private property: {{ looks_sentence }}. Tell us about the shoot or the celebration and we'll come back with dates.</p>
      <a class="btn" href="mailto:{{ v.contact.email }}?subject=Filming%20or%20private%20event">Email about a shoot or event</a>
    </div>
  </div>
</section>

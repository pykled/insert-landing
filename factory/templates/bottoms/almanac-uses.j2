<section class="uses uses-al" aria-label="{{ secondary_uses_sentence }}" id="uses" data-bottom="almanac">
  <div class="container">
    <div class="al-strip reveal">
      <h2>{{ secondary_uses_sentence }}.</h2>
      <p>{% if v.spaces|length > 1 %}{{ looks_sentence|capitalize }}, on one property. {% endif %}{% if v.contact.email %}Write to the venue about {{ 'a shoot or an event' if uses_shoot else 'your event' }}.{% endif %}</p>
      {% if v.contact.email %}<a class="al-link" href="mailto:{{ v.contact.email }}?subject={{ 'Filming%20or%20private%20event' if uses_shoot else 'Private%20event' }}">Email about {{ 'a shoot or event' if uses_shoot else 'your event' }}</a>{% endif %}
    </div>
  </div>
</section>

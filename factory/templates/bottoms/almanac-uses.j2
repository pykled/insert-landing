<section class="uses uses-al" aria-label="Filming and private events" id="uses" data-bottom="almanac">
  <div class="container">
    <div class="al-strip reveal">
      <h2>{{ v.tagline_facts.uses[1:]|join(' and ')|capitalize }}.</h2>
      <p>{{ v.tagline_facts.space_count }} distinct looks on one private property: {{ looks_sentence }}. Tell us about the shoot or the celebration and we'll come back with dates.</p>
      <a class="al-link" href="mailto:{{ v.contact.email }}?subject=Filming%20or%20private%20event">Email about a shoot or event</a>
    </div>
  </div>
</section>

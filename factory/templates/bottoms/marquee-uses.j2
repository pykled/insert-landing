<section class="uses uses-mq" aria-label="Filming and private events" id="uses" data-bottom="marquee">
  <div class="container">
    <div class="mq-uses band-ink reveal">
      <div class="mq-uses-label">
        <p class="mq-label">{% for u in v.tagline_facts.uses[1:] %}{{ u }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
        {% if v.tagline_facts.space_count %}<p class="mq-count"><b>{{ v.tagline_facts.space_count }}</b> looks</p>{% endif %}
      </div>
      <div>
        <h2>{{ v.tagline_facts.uses[1:]|join(' and ')|capitalize }}.</h2>
        <p>{{ v.tagline_facts.space_count }} distinct looks on one private property: {{ looks_sentence }}. Tell us about the shoot or the celebration and we'll come back with dates.</p>
        <a class="btn btn-light" href="mailto:{{ v.contact.email }}?subject=Filming%20or%20private%20event">Email about a shoot or event</a>
      </div>
    </div>
  </div>
</section>

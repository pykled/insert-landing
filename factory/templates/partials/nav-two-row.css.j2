  /* nav: two-row (wordmark row + sub-nav row) */
  .nav-two-row .nav-row1 { min-height: 64px; }
  .nav-two-row .nav-right { display: flex; align-items: center; gap: 22px; }
  .nav-two-row .nav-place { font-size: 11.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft); font-weight: {{ pair.body.medium }}; white-space: nowrap; }
  .nav-two-row .nav-row2 { border-top: 1px solid var(--line); }
  .nav-two-row .nav-row2 .nav-links { min-height: 44px; align-items: center; gap: clamp(22px, 3vw, 44px); }
  .nav-two-row .nav-row2 .nav-links a { padding: 12px 0; }
  @media (max-width: 1024px) {
    .nav-two-row .nav-place { display: none; }
  }
  @media (max-width: 860px) {
    .nav-two-row .nav-row2 { display: none; border-top: 0; }
    header.site.nav-two-row[data-open] .nav-row2 { display: block; }
    header.site.nav-two-row[data-open] .nav-row2 .nav-links { align-items: stretch; gap: 0; min-height: 0; }
    header.site.nav-two-row[data-open] .nav-row2 .nav-links a { padding: 16px var(--gutter); }
  }

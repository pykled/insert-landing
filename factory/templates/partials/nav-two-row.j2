{#- nav `two-row` (modern-luxe, deco): wordmark row + hairlined sub-nav row. <= 8 links in the header (brand + at most
    six section links + the CTA), no dropdowns (E14). The CSS rides inside the partial because base.html.j2 includes
    only the nav .j2 (see STAGE-2B-NOTES-sections.md). -#}
{% set nav_items = (sections|selectattr('nav')|list)[:6] %}
<style>
{% include 'partials/nav-two-row.css.j2' %}
</style>
<header class="site nav-two-row" id="top">
  <div class="container nav nav-row1">
    <a class="brand" href="#top" aria-label="{{ v.name }}, home"><span class="brand-word">{{ v.short_name }}</span></a>
    <div class="nav-right">
      <p class="nav-place">{{ v.tagline_facts.locality }}{% if v.tagline_facts.region %} · {{ v.tagline_facts.region }}{% endif %}</p>
      <a class="btn" href="#check">{{ copy.nav_cta }}</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu"><span></span></button>
    </div>
  </div>
  <div class="nav-row2">
    <nav class="container" aria-label="Sections">
      <ul class="nav-links" id="nav-links">
        {% for s in nav_items %}<li><a href="#{{ s.id }}">{{ s.nav }}</a></li>{% endfor %}
      </ul>
    </nav>
  </div>
</header>

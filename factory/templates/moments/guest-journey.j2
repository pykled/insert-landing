{% set steps = v.journey.steps|select("in", spaces_by_id)|list %}
<section id="journey" class="journey" aria-labelledby="journey-title">
  <div class="container">
    <div class="section-head">
      <p class="kicker reveal">A guest's day</p>
      {% set j0, j1 = spaces_by_id[steps[0]], spaces_by_id[steps[-1]] %}<h2 id="journey-title" class="reveal d1">From {{ j0.name|replace('The ', 'the ') }} to <em>{{ j1.name|replace('The ', 'the ') }}.</em></h2>
      <p class="lede reveal d2">Where each part of the day happens, as the venue describes it. Scroll.</p>
    </div>
    <div class="journey-grid">
      <div class="journey-stage" aria-hidden="true">
        {# 3A item 5: the stage ratio follows its widest photo so none is drawn past MAX_CROP #}
        {% set ns = namespace(ph=photos[spaces_by_id[steps[0]].photo]) %}{% for sid in steps %}{% set _p = photos[spaces_by_id[sid].photo] %}{% if _p.width / _p.height > ns.ph.width / ns.ph.height %}{% set ns.ph = _p %}{% endif %}{% endfor %}
        {% set _ar = fit_ratio(ns.ph, '4 / 5') %}
        <div class="ph jstage-ph" style="--ar: {{ _ar }}">
          {% for sid in steps %}{% set s = spaces_by_id[sid] %}<img class="jstage-img{% if loop.first %} on{% endif %}" data-step="{{ loop.index0 }}" src="{{ photos[s.photo].src }}" srcset="{{ photos[s.photo].srcset }}" sizes="{{ '(min-width: 861px) 42vw, 1px'|cover(photos[s.photo], _ar) }}" width="{{ photos[s.photo].width }}" height="{{ photos[s.photo].height }}" alt="" style="object-position: {{ photos[s.photo].focal }}" loading="lazy" decoding="async">{% endfor %}
        </div>
      </div>
      <ol class="journey-steps" id="journey-steps">
        {% for sid in steps %}{% set s = spaces_by_id[sid] %}
        <li class="jstep{% if loop.first %} active{% endif %}" data-step="{{ loop.index0 }}">
          <span class="jnum">{{ '%02d' % loop.index }}</span>
          <h3>{{ s.journey_step or s.name }}</h3>
          <p class="jwhere">{{ s.name }}{% if s.capacity_label %} · {{ s.capacity_label }}{% endif %}</p>
          <p class="jblurb" data-optional-copy>{{ s.blurb }}</p>
          <div class="ph jstep-ph"><img src="{{ photos[s.photo].src }}" srcset="{{ photos[s.photo].srcset }}" sizes="100vw" width="{{ photos[s.photo].width }}" height="{{ photos[s.photo].height }}" alt="{{ photos[s.photo].alt }}" style="object-position: {{ photos[s.photo].focal }}" loading="lazy" decoding="async"></div>
        </li>
        {% endfor %}
      </ol>
    </div>
    {# 3A: journey.note is the reviewer's provenance for the order (which pages state it); never printed to visitors #}
  </div>
</section>

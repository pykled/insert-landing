  /* moment: then / now (deco): archival photo clipped over today's; brass handle; the range input is the control */
  .mo-tn-head { margin-bottom: clamp(24px, 3vw, 40px); }
  .mo-tn-head h2 { font-size: clamp({{ pair.display.min_px|default(32) }}px, 3.4vw, 50px); margin-top: 10px; max-width: 22ch; }
  .mo-tn-fig { margin: 0; }
  .mo-tn-stage { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--paper-3); touch-action: pan-y; }
  .mo-tn-stage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mo-tn-then { filter: grayscale(1) contrast(1.05); clip-path: inset(0 calc(100% - var(--split)) 0 0); }
  .mo-tn-handle { position: absolute; top: 0; bottom: 0; left: var(--split); width: 0; border-left: 1px solid var(--metal, var(--accent)); pointer-events: none; }
  .mo-tn-knob { position: absolute; top: 50%; left: 0; width: 44px; height: 44px; margin: -22px 0 0 -22px; overflow: visible; filter: drop-shadow(0 1px 3px rgba(0, 0, 0, .25)); }
  .mo-tn-knob circle { fill: var(--paper); stroke: var(--metal, var(--accent)); stroke-width: 1; }
  .mo-tn-knob path { fill: none; stroke: var(--ink); stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  .mo-tn-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; }
  .mo-tn-stage:has(.mo-tn-range:focus-visible) .mo-tn-knob circle { stroke: var(--focus, var(--ink)); stroke-width: 3; }
  .mo-tn-cap { display: grid; gap: 6px; margin-top: 14px; font-size: 15px; color: var(--ink-soft); }
  .mo-tn-cap span { max-width: 72ch; }
  .mo-tn-cap b { font-weight: {{ pair.body.medium }}; color: var(--ink); letter-spacing: .08em; text-transform: uppercase; font-size: 13.5px; }

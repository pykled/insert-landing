  /* moment: slideshow counter (one photo at a time, user-advanced, cross-fade) — shared with pairs-counter */
  .mo-ss-head { display: flex; justify-content: space-between; align-items: end; gap: 20px 32px; flex-wrap: wrap; margin-bottom: clamp(22px, 3vw, 36px); }
  .mo-ss-head h2 { font-size: clamp({{ pair.display.min_px|default(32) }}px, 3.2vw, 48px); margin-top: 10px; max-width: 20ch; }
  .mo-ss-ctl { display: flex; align-items: center; gap: 8px; }
  .mo-counter { margin: 0 14px 0 0; font-size: 15px; font-weight: {{ pair.body.medium }}; letter-spacing: .18em; color: var(--ink); font-variant-numeric: tabular-nums lining-nums; white-space: nowrap; }
  .mo-counter b { font-weight: inherit; color: var(--accent-text); }
  .mo-step { width: 48px; height: 48px; display: inline-grid; place-items: center; font: inherit; font-size: 19px; line-height: 1; border: 1px solid var(--line-strong); border-radius: var(--radius, 0); background: transparent; color: var(--ink); cursor: pointer; transition: background .25s var(--ease), color .25s var(--ease); }
  .mo-step:hover:not(:disabled) { background: var(--ink); color: var(--paper); }
  .mo-step:disabled { cursor: default; color: var(--ink-faint); border-color: var(--line); }
  .mo-step:focus-visible, .mo-ss-stage:focus-visible { outline: 2px solid var(--focus, var(--ink)); outline-offset: 3px; }
  .mo-ss-stage { display: grid; }
  .mo-ss-item { grid-area: 1 / 1; margin: 0; opacity: 0; visibility: hidden; transition: opacity {{ [[t.motion_device_ms|default(1200), 600]|max, 1600]|min }}ms var(--ease), visibility 0s linear {{ [[t.motion_device_ms|default(1200), 600]|max, 1600]|min }}ms; }
  .mo-ss-item.on { opacity: 1; visibility: visible; transition-delay: 0s; }
  .mo-ss-item .ph { aspect-ratio: 16 / 9; }
  .mo-ss-item figcaption, .mo-pair figcaption { display: flex; justify-content: space-between; gap: 6px 18px; flex-wrap: wrap; padding-top: 14px; border-top: 1px solid var(--line); margin-top: 14px; }
  .mo-ss-t { font-size: 17px; color: var(--ink); max-width: 60ch; }
  .mo-ss-n { font-size: 15px; color: var(--ink-soft); letter-spacing: .04em; }
  @media (max-width: 860px) { .mo-ss-item .ph { aspect-ratio: 4 / 3; } .mo-ss-head { align-items: start; } }
  @media (prefers-reduced-motion: reduce) { .mo-ss-item, .mo-ss-item.on { transition: none; } }
